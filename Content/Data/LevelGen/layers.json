{
  "schema": "codex.levelgen_layers/1",
  "comment": "Level generator LAYERS (designer spec 2026-11-16; Tools/TrainingGround/src/levelgen/layers.ts). Every entity of a layout (zones, buildings, walls, covers, the canal and its crossings, ladders, routes, points, mantle edges, start + goals) and every object of the map's props file belongs to EXACTLY ONE layer. A layer lists `match` rules; a rule matches an entity when its `type` and every other key it names match (kinds = the entity's kind: wall.kind / cover.kind / crossing.kind / the props layer kind / ...; set_pieces; id_regex; variants = the prop's variant; size_class = small | medium | large from size_classes below). A rule with `fallback: true` takes the entities of its type that no other rule takes. The tool refuses a config where an entity matches two layers or none (layers.test.ts). group: main = the designer's list, analysis = computed overlays, threats = sub-layers of the chokepoint analysis, service = what the designer's list does not name but the plan draws. edit = the tools the layer offers (select, move, delete, add, reroll). Colours are the plan's and the panel's.",
  "size_classes": {
    "comment": "Obstacle SIZE CLASS (walls of kind wall / fence / curb, covers, crate / barrel props) by height and footprint. small = up to small_max_height_cm (the low vault / low mantle classes of obstacle_heights.json: 85 and 95 cm + tolerance, vaulted on the move, crouch cover). large = from large_min_height_cm (the tall-ledge class 230 cm and above: blocks a standing man's view, 310 / 330 cm walls, silos) OR a footprint of large_min_footprint_m2 and more when it is taller than small. medium = everything between (the 135 / 140 cm classes: standing cover, a high climb). kind_class overrides the rule for a cover kind / prop variant (empty = none).",
    "small_max_height_cm": 105,
    "large_min_height_cm": 230,
    "large_min_footprint_m2": 20,
    "kind_class": {}
  },
  "layers": [
    { "id": "roads", "name": "Дороги", "group": "main", "color": "#8b8b96", "edit": ["select", "delete"],
      "hint": "Только участки, которые считаются дорогой: зоны улиц (Z_ST_*, тип street).",
      "match": [ { "type": "zone", "id_regex": "^Z_ST_" }, { "type": "zone", "set_pieces": ["street"] } ] },
    { "id": "buildings", "name": "Здания / структуры", "group": "main", "color": "#aa9678", "edit": ["select", "delete", "reroll"],
      "hint": "Здания со стенами, перегородками, парапетами и лестницами на крыши / этажи.",
      "match": [ { "type": "building" }, { "type": "wall", "kinds": ["building", "interior", "partition", "parapet"] }, { "type": "ladder", "kinds": ["roof", "floor", "ground"] } ] },
    { "id": "bridges", "name": "Мосты", "group": "main", "color": "#c8c8be", "edit": ["select"],
      "hint": "Мосты и пандусы через канал.",
      "match": [ { "type": "crossing" } ] },
    { "id": "obstacles_large", "name": "Преграды крупные", "group": "main", "color": "#ef4444", "edit": ["select", "move", "delete", "add", "reroll"], "size_class": "large",
      "match": [ { "type": "wall", "kinds": ["wall", "fence", "curb"], "size_class": "large" }, { "type": "cover", "size_class": "large" }, { "type": "prop", "variants": ["barrel", "crate_s", "crate_l"], "size_class": "large" } ],
      "add": [ { "label": "стена 3,3 м (4 м)", "wall": { "kind": "wall", "length": 400, "height": 330, "thickness": 30 } } ] },
    { "id": "obstacles_medium", "name": "Преграды средние", "group": "main", "color": "#f59e0b", "edit": ["select", "move", "delete", "add", "reroll"], "size_class": "medium",
      "match": [ { "type": "wall", "kinds": ["wall", "fence", "curb"], "size_class": "medium" }, { "type": "cover", "size_class": "medium" }, { "type": "prop", "variants": ["barrel", "crate_s", "crate_l"], "size_class": "medium" } ],
      "add": [ { "label": "остов машины", "cover": { "kind": "wreck", "size": [420, 180, 140] } }, { "label": "котёл", "cover": { "kind": "boiler", "size": [200, 120, 140] } }, { "label": "ящик высокий", "cover": { "kind": "crate", "size": [120, 120, 140] } }, { "label": "забор 1,35 м (4 м)", "wall": { "kind": "fence", "length": 400, "height": 135, "thickness": 10 } } ] },
    { "id": "obstacles_small", "name": "Преграды мелкие", "group": "main", "color": "#fde047", "edit": ["select", "move", "delete", "add", "reroll"], "size_class": "small",
      "match": [ { "type": "wall", "kinds": ["wall", "fence", "curb"], "size_class": "small" }, { "type": "cover", "size_class": "small" }, { "type": "prop", "variants": ["barrel", "crate_s", "crate_l"], "size_class": "small" } ],
      "add": [ { "label": "ящик низкий", "cover": { "kind": "crate", "size": [120, 120, 85] } }, { "label": "бочка", "cover": { "kind": "barrel", "size": [60, 60, 95] } }, { "label": "бетонный блок", "cover": { "kind": "jersey", "size": [300, 60, 95] } }, { "label": "мешки", "cover": { "kind": "sandbag", "size": [250, 80, 95] } } ] },
    { "id": "mines", "name": "Мины", "group": "main", "color": "#f43f5e", "edit": ["select", "move", "delete", "add"], "props": true,
      "match": [ { "type": "prop", "kinds": ["mines"] } ],
      "add": [ { "label": "мина", "prop": { "kind": "mines", "variant": "mine", "fields": { "trigger": "proximity" } } }, { "label": "растяжка", "prop": { "kind": "mines", "variant": "mine", "fields": { "trigger": "tripwire" } } } ] },
    { "id": "loot", "name": "Лут", "group": "main", "color": "#34d399", "edit": ["select", "move", "delete", "add"], "props": true,
      "match": [ { "type": "prop", "kinds": ["loot"] } ],
      "add": [ { "label": "лут (куча)", "prop": { "kind": "loot", "variant": "loot_pile", "fields": {} } } ] },
    { "id": "special", "name": "Особые предметы", "group": "main", "color": "#c084fc", "edit": ["select", "move", "delete", "add"], "props": true,
      "hint": "Турели, складные баррикады, взрывные бочки и всё, что не мина, не лут и не простая преграда.",
      "match": [ { "type": "prop", "kinds": ["turrets"] }, { "type": "prop", "variants": ["barrel_explosive"] }, { "type": "prop", "fallback": true } ],
      "add": [ { "label": "турель", "prop": { "kind": "turrets", "variant": "turret_mg", "fields": { "arc": 90 } } }, { "label": "взрывная бочка", "prop": { "kind": "barrels", "variant": "barrel_explosive", "fields": {} } } ] },
    { "id": "objectives", "name": "Цели", "group": "main", "color": "#facc15", "edit": ["select", "move", "delete", "add"],
      "hint": "Старт (S) и цели 1, 2, 3, 4 — жёлтые с номерами.",
      "match": [ { "type": "objective" } ] },
    { "id": "fire_lines", "name": "Линия огня", "group": "analysis", "color": "#f87171", "edit": [],
      "hint": "Линии огня из окон и бойниц на основной маршрут (оценка «Тактика зданий»).",
      "match": [ { "type": "analysis", "kinds": ["fire_line"] } ] },
    { "id": "chokepoints", "name": "Узкие места (засады / заторы)", "group": "analysis", "color": "#fb7185", "edit": [],
      "hint": "Автоматический анализ: узкие проходы, завалы, каньоны, единственные пути и угрозы (chokepoints.json).",
      "match": [ { "type": "analysis", "kinds": ["chokepoint"] } ] },
    { "id": "threat_drop", "name": "Засада сверху (точки спрыгивания)", "group": "threats", "color": "#f97316", "edit": [],
      "match": [ { "type": "analysis", "kinds": ["drop_spot"] } ] },
    { "id": "threat_windows", "name": "Окна, простреливающие места", "group": "threats", "color": "#38bdf8", "edit": [],
      "match": [ { "type": "analysis", "kinds": ["window"] } ] },
    { "id": "threat_overwatch", "name": "Снайперские позиции на крышах", "group": "threats", "color": "#e879f9", "edit": [],
      "match": [ { "type": "analysis", "kinds": ["overwatch"] } ] },
    { "id": "threat_hiding", "name": "Укрытия для засады (скрытый противник)", "group": "threats", "color": "#a3e635", "edit": [],
      "match": [ { "type": "analysis", "kinds": ["hiding"] } ] },
    { "id": "canal", "name": "Канал / выемка", "group": "service", "color": "#465aa0", "edit": ["select"],
      "match": [ { "type": "cut" }, { "type": "wall", "kinds": ["cut_wall"] }, { "type": "zone", "id_regex": "^Z_cut" }, { "type": "ladder", "kinds": ["cut"] } ] },
    { "id": "blocks", "name": "Кварталы (зоны)", "group": "service", "color": "#64748b", "edit": ["select"],
      "match": [ { "type": "zone", "fallback": true } ] },
    { "id": "routes", "name": "Маршруты и точки врага", "group": "service", "color": "#008cff", "edit": [],
      "match": [ { "type": "route" }, { "type": "point" } ] },
    { "id": "mantle", "name": "Кромки перелаза", "group": "service", "color": "#c084fc", "edit": [],
      "match": [ { "type": "mantle_edge" } ] }
  ]
}
