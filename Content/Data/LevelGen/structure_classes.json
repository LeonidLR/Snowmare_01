{
  "schema": "codex.structure_classes/1",
  "comment": "Structural class + material of every wall segment, partition and opening of a schema /2 layout (lead addendum 2026-11-21, designer: future destruction; NOTHING reads it yet). Read by Tools/TrainingGround/src/levelgen/structureClasses.ts (written onto layout walls[], buildings[].partitions[] and every opening at finalize when building_plans is on) and passed through by Scripts/Editor/build_levelgen_map.py as actor tags structure=<class> / material=<material>. rules: per archetype (GenBuilding.archetype; 'default' for buildings without one), the class / material of a wall by its role: 'perimeter' (the outer walls), 'core' (the walls of a stair core room and its lane walls), 'cross' (a wall between two flats or between a flat and a common room - the panel block's transverse bearing walls), 'inner' (every other interior wall). free_walls: walls of no building, by their kind. An opening takes its host wall's class and material. classes: the placeholder durability table (class + material -> hp_class), values TBD - no number is decided.",
  "structures": ["load_bearing", "partition", "annex", "facade"],
  "materials": ["concrete_panel", "brick", "plaster", "wood", "sheet_metal"],
  "rules": {
    "block": { "perimeter": ["load_bearing", "concrete_panel"], "core": ["load_bearing", "concrete_panel"], "cross": ["load_bearing", "concrete_panel"], "inner": ["partition", "plaster"] },
    "shop_flats": { "perimeter": ["load_bearing", "concrete_panel"], "core": ["load_bearing", "concrete_panel"], "cross": ["load_bearing", "concrete_panel"], "inner": ["partition", "plaster"] },
    "hospital": { "perimeter": ["load_bearing", "brick"], "core": ["load_bearing", "brick"], "cross": ["load_bearing", "brick"], "inner": ["partition", "plaster"] },
    "office": { "perimeter": ["load_bearing", "brick"], "core": ["load_bearing", "brick"], "cross": ["partition", "plaster"], "inner": ["partition", "plaster"] },
    "hall": { "perimeter": ["facade", "sheet_metal"], "core": ["load_bearing", "concrete_panel"], "cross": ["partition", "sheet_metal"], "inner": ["partition", "sheet_metal"] },
    "warehouse": { "perimeter": ["facade", "sheet_metal"], "core": ["load_bearing", "concrete_panel"], "cross": ["partition", "sheet_metal"], "inner": ["partition", "sheet_metal"] },
    "gallery": { "perimeter": ["facade", "sheet_metal"], "core": ["load_bearing", "concrete_panel"], "cross": ["partition", "sheet_metal"], "inner": ["partition", "sheet_metal"] },
    "shed": { "perimeter": ["annex", "wood"], "core": ["annex", "wood"], "cross": ["annex", "wood"], "inner": ["partition", "wood"] },
    "ruin": { "perimeter": ["load_bearing", "brick"], "core": ["load_bearing", "brick"], "cross": ["load_bearing", "brick"], "inner": ["partition", "brick"] },
    "shell": { "perimeter": ["load_bearing", "brick"], "core": ["load_bearing", "brick"], "cross": ["partition", "plaster"], "inner": ["partition", "plaster"] },
    "default": { "perimeter": ["load_bearing", "brick"], "core": ["load_bearing", "brick"], "cross": ["partition", "plaster"], "inner": ["partition", "plaster"] }
  },
  "free_walls": {
    "fence": ["annex", "sheet_metal"],
    "default": ["annex", "brick"]
  },
  "classes": {
    "load_bearing/concrete_panel": { "hp_class": "TBD" },
    "load_bearing/brick": { "hp_class": "TBD" },
    "partition/plaster": { "hp_class": "TBD" },
    "partition/sheet_metal": { "hp_class": "TBD" },
    "partition/wood": { "hp_class": "TBD" },
    "partition/brick": { "hp_class": "TBD" },
    "facade/sheet_metal": { "hp_class": "TBD" },
    "annex/wood": { "hp_class": "TBD" },
    "annex/sheet_metal": { "hp_class": "TBD" },
    "annex/brick": { "hp_class": "TBD" }
  }
}
